\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cvstyle}[2026/07/25 Shared style for Lindsay K Pino's CV documents]

% Shared preamble for pino_cv.tex, pino_cv-short.tex, and pino_resume.tex.
% Each document supplies only its own \documentclass and content.

\RequirePackage{xcolor}
\RequirePackage[english]{babel}
\RequirePackage{array}
\RequirePackage{fancyhdr}
% `hidelinks` takes no value; writing `hidelinks=true` made hyperref reject the
% option outright, so links were drawn with visible borders.
\RequirePackage[hidelinks]{hyperref}

% Reverse Numbering
\RequirePackage{etaremune}

% Set 1-inch margins.
\RequirePackage[margin=1in]{geometry}

% Running head title. Override per document, e.g.
%   \renewcommand{\cvdoctitle}{Resume}
\newcommand{\cvdoctitle}{Curriculum Vitae}

% Headers and Footer
% fancyhdr needs >=13.6pt for this header; shrink \topmargin by the same amount
% so the body text stays where it was.
\setlength{\headheight}{14pt}
\addtolength{\topmargin}{-2pt}

\pagestyle{fancy}
\fancyhf{}
\rhead{\textbf{Lindsay K.\ Pino}}
\lhead{\textbf{\cvdoctitle}}
\rfoot{\thepage}
\renewcommand{\headrulewidth}{0pt}

\fancypagestyle{plain}{
  \fancyhf{}
  \rfoot{\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

% Sans-serif throughout, using Helvetica (URW Nimbus Sans). This ships with
% every TeX distribution, so there is nothing extra to download; the previous
% Roboto package was a 76 MB dependency. `scaled` trims Helvetica's large
% x-height so the text density stays close to what Roboto gave.
\RequirePackage[T1]{fontenc}
\RequirePackage[scaled]{helvet}
\renewcommand{\familydefault}{\sfdefault}

% Skip a line between paragraphs.
\setlength{\parskip}{1.5ex}

% Turn off indenting.
\setlength{\parindent}{0in}

% Define the section command.
\newcommand{\mysection}[1]{\vspace{1ex {\bf \large #1} \quad
    \hrulefill}}
\newcommand{\mysubsection}[1]{\vspace{1ex {\bf #1}}}

% Set the numbering style.
\renewcommand{\labelenumi}{(\arabic{enumi})}

% Make the \footnote command print symbols (*, etc).
\renewcommand{\thefootnote}{\fnsymbol{footnote}}

% Smarter version of href. Typeset URLs in the document's sans font rather than
% typewriter: the T1 typewriter face has no Type1 version here, so LaTeX would
% fall back to generating 600dpi bitmap fonts that print fuzzy and don't scale.
\urlstyle{sf}
\newcommand{\myref}[1]{\href{#1}{\url{#1}}}

% Table sizes
\newlength{\leftcol}
\setlength{\leftcol}{0.6in}
\newlength{\rightcol}
\setlength{\rightcol}{5.25in}
% The two-column layout used by every table in these documents: a narrow date
% column and a wide description column. Write it as \begin{tabular}{V}.
%
% A p-column starts a fresh paragraph, which resets the document's \raggedright
% back to justified -- that is what produced stretched word spacing inside these
% tables. Declaring the columns ragged keeps them matching the body text.
% (\arraybackslash restores \\ , which \raggedright would otherwise steal.)
%
% This is a \newcolumntype rather than a plain macro because the array package
% parses table preambles strictly and will not expand an ordinary command there.
\newcolumntype{V}{%
  >{\raggedright\arraybackslash}p{\leftcol}%
  >{\raggedright\arraybackslash}p{\rightcol}%
}
\renewcommand{\arraystretch}{1.25} % make rows taller

% No hyphenation
\pretolerance=10000
\raggedright

% colors
\definecolor{cvgray}{HTML}{404040}
\color{cvgray}

% Publication tallies shown under the Peer-Reviewed Publications heading.
% Defined once here so the three documents cannot drift apart -- update these two
% numbers when a paper lands and every document picks it up.
%
% Usage: \pubcount              -> (20 total, 8 first author)
%        \pubcount[; selection below]
\newcommand{\pubtotal}{21}
\newcommand{\pubfirstauthor}{9}
\newcommand{\pubcount}[1][]{%
  {\small (\pubtotal{} total, \pubfirstauthor{} first author#1)}%
}

% Hiding entries without deleting them.
%
% pino_cv.tex is the complete record -- every talk, poster, award, and workshop
% ever, whether or not it is worth printing. Entries that are real but not worth
% the page space are wrapped in \hide{...} rather than commented out, so the
% record stays intact and machine-readable while the rendered CV stays tight.
%
%   \showalltrue   -> complete version: nothing is suppressed
%   \showallfalse  -> curated version: \hide{...} entries vanish
%
% Hidden text is gobbled before typesetting, so it never reaches the PDF.
%
% The \expandafter dance resolves the conditional *before* the entry's tokens
% appear. A plain \ifshowall#1\fi would leave \fi stranded after the \\ that
% ends a table row, which breaks the alignment.
\newif\ifshowall
\showalltrue
\makeatletter
\newcommand{\hide}{\ifshowall\expandafter\@firstofone\else\expandafter\@gobble\fi}
\makeatother

% Name and contact block that opens each document.
\newcommand{\cvheader}{%
  \thispagestyle{plain}%
  \begin{center}
    {\bf \Large Lindsay K Pino, PhD}
    \par
    lindsay.pino@gmail.com \\
    % {phone #}\\
    \href{https://lindsaykpino.com/}{lindsaykpino.com}\\
    Updated \today.
  \end{center}%
}

\endinput
